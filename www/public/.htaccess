RewriteEngine on
 
# --------------------------------------------
# Fichiers ou dossiers réels (css, js, images, pdf, zip, etc.) : pas de réécriture, on les sert tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
 
# --------------------------------------------
# RÈGLES DE RÉ-ÉCRITURE
# ROUTE TESTS.SHOW
# PATTERN:tests/x/slug.html
# TARGET: index.php?tests=show&id=x
#RewriteRule ^/tests\/([1-9][0-9]*)/([a-z0-9][a-z0-9\-]*[a-z0-9])\.html$ ?tests=show&#id=$1 [L]
#RewriteRule ^pattern$ target [L]
 
# --------------------------------------------
# FALLBACK
# Toute autre URL non prise en charge par une route ci-dessus part vers le front controller
RewriteRule ^ index.php [L]
